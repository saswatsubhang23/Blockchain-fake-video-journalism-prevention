# =============================================================================
# VIDEO ARCHIVAL DIPLOMATICS - SAFE SAMPLE ENV
# Copy this file to ".env" and update values as needed.
# =============================================================================

# -------------------------
# Server
# -------------------------
PORT=3000
NODE_ENV=production

# Directory where uploaded files are written temporarily
UPLOAD_DIR=uploads

# Maximum file size (bytes). 1 GiB = 1073741824
MAX_FILE_SIZE=1073741824

# -------------------------
# IPFS
# -------------------------
# Docker Compose (when app runs in container)
IPFS_ENDPOINT=http://ipfs:5001

# Optional (only for external gateways like Infura)
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# -------------------------
# Neo4j
# -------------------------
# Docker Compose (inside app container)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# -------------------------
# Ethereum (optional)
# -------------------------
# Example public testnet endpoint (Sepolia)
ETH_RPC_URL=
# Never commit real private keys. Keep this empty or load from secrets manager.
ETH_PRIVATE_KEY=
# Set after deploying HashRegistry.sol (optional)
CONTRACT_ADDRESS=
# Chain ID (Sepolia = 11155111, Mainnet = 1, Local Hardhat = 31337)
CHAIN_ID=11155111
# Optional key for verifying on Etherscan (if/when you verify contracts)
ETHERSCAN_API_KEY=