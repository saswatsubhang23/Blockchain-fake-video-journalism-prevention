{
  "name": "video-archival-diplomatics",
  "version": "2.0.0",
  "description": "Backend service for video archival diplomatics verification with IPFS, Blockchain (optional), and Neo4j.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/envCheck.js",
    "start": "node src/server.js",
    "predev": "node scripts/envCheck.js",
    "dev": "nodemon src/server.js",
    "env:check": "node scripts/envCheck.js",
    "neo4j:init": "node scripts/initNeo4j.js",
    "contracts:compile": "hardhat compile",
    "contracts:deploy": "hardhat run scripts/deploy.cjs --network sepolia",
    "contracts:deploy:local": "hardhat run scripts/deploy.cjs --network localhost"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ipfs-http-client": "^60.0.1",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "neo4j-driver": "^5.28.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.26.3",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}